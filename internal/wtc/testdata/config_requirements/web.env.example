# taba:requirements v1
# taba:source {"files":[{"path":"web.env","scope":"project","format":"dotenv"},{"path":"web.local.env","scope":"collection","format":"dotenv"}],"env_names":["WEB_CONNECTION"],"env_prefixes":["WEB_TEST_"]}
# taba:require {"kind":"config","choices":["local","remote"],"purpose":"Choose the connection for tests","affects":"web tests","required":"required","scope":"collection","example":"nonsecret-default","hint":"Choose local or remote","doc":"docs/testing.md"}
WEB_CONNECTION=remote
# taba:require {"kind":"secret","purpose":"Authenticate remote tests","affects":"remote web tests","required":"conditional","scope":"project","example":"placeholder","hint":"Request a development test credential from the service owner","doc":"docs/testing.md","when":{"key":"WEB_CONNECTION","equals":"remote"}}
WEB_TEST_TOKEN=replace-me
# taba:require {"kind":"config","purpose":"Enable optional tracing","affects":"web traces","required":"optional","scope":"collection","example":"nonsecret-default","hint":"Set true to collect traces","doc":"docs/testing.md"}
WEB_TRACE=false
# taba:file {"file":"certs/test.pem","kind":"secret","purpose":"Authenticate a separate integration","affects":"full integration","required":"optional","scope":"collection","example":"placeholder","hint":"Request the development certificate from the service owner","doc":"docs/testing.md"}
